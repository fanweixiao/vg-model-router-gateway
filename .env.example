# Copy to .env (or .env.local) and fill in. Both files are git-ignored.
# Precedence: real environment variables > .env.local > .env

# LISTEN=127.0.0.1:33333
# https://api.vivgrid.com/v1/responses=https://api.vivgrid.com/v1/responses
# RUST_LOG=vg_model_router=info

# Config file (defaults to ./vg-model-router.toml)
# CONFIG=vg-model-router.toml

# vivgrid API key. Fallback only: used when a request arrives without an
# Authorization header. It then covers both the upstream call and the classifier,
# which always reuse the same Authorization as the request being proxied.
# VIVGRID_API_KEY=
